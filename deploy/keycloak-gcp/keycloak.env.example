# Copy to keycloak.env on the VM (/opt/openhat/keycloak-gcp/). Gitignore keycloak.env.

KEYCLOAK_PUBLIC_HOST=auth.example.com

# Postgres (POSTGRES_PASSWORD is standard postgres image var)
POSTGRES_PASSWORD=replace-me

# Keycloak bootstrap admin (KC_BOOTSTRAP_* — see Keycloak 26 container docs)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me
