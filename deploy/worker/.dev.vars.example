# Local wrangler secrets — copy to .dev.vars (gitignored). Never commit secrets.
# JWKS verify for portal mint only needs the issuer:
KEYCLOAK_ISSUER=http://localhost:8080/realms/openhat
# Optional legacy ohqs-api client (console OIDC removed — portal owns login):
# KEYCLOAK_CLIENT_ID=ohqs-api
# KEYCLOAK_CLIENT_SECRET=paste-from-keycloak-client-credentials
# Optional emergency local-only embed gate. Prefer minting an ai_admin API token in portal.
# ADMIN_TOKEN=
